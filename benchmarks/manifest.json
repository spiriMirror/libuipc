{
  "schemaVersion": 1,
  "benchmarks": [
    {
      "name": "rigid-wrecking-balls",
      "description": "Pure affine-body wrecking-ball contact benchmark",
      "entrypoint": "libuipc-samples/examples/6_wrecking_balls/main.py",
      "workingDirectory": "libuipc-samples/examples/6_wrecking_balls",
      "arguments": ["--headless", "{frames}"],
      "defaultFrames": 120,
      "quickFrames": 3,
      "requiredPaths": [
        "libuipc-samples/examples/6_wrecking_balls/main.py",
        "libuipc-samples/examples/6_wrecking_balls/asset_dir.py",
        "libuipc-samples/examples/benchmark_utils.py",
        "libuipc-samples/assets/sim_data/wrecking_ball.json",
        "libuipc-samples/assets/sim_data/tetmesh/cube.msh",
        "libuipc-samples/assets/sim_data/tetmesh/ball.msh",
        "libuipc-samples/assets/sim_data/tetmesh/link.msh"
      ],
      "environment": {
        "WB_LOG": "Warn",
        "UIPC_BENCHMARK_TIMERS": "0"
      },
      "unsetEnvironment": ["WB_TIMER"],
      "metadataOutput": "output/benchmark-runs/rigid-wrecking-balls.json",
      "comparability": "Keep the sample scene/configuration unchanged; compare identical repo, samples, CUDA, GPU, driver, and frame counts."
    },
    {
